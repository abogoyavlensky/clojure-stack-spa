{:tasks
 {:enter (println "Running task:" (:name (current-task)))

  deps {:doc "Install all deps"
        :task (do
                (clojure "-P -X:dev")
                (clojure "-P -X:test")
                (clojure "-P -X:outdated")
                (clojure "-P -X:build")
                (clojure "-P")
                (run 'frontend-install))}

  clj-repl {:doc "Run built-in Clojure REPL"
            :task (shell "clj -A:dev:test")}

  fmt-check {:doc "Check code formatting"
             :task (shell "cljfmt" "check")}

  fmt {:doc "Fix code formatting"
       :task (shell "cljfmt" "fix")}

  lint-init {:doc "Linting project's classpath"
             :task (shell "clj-kondo" "--parallel" "--dependencies" "--copy-configs"
                     "--lint" (with-out-str (clojure "-Spath")))}

  lint {:doc "Linting project's code"
        :task (shell "clj-kondo" "--parallel" "--lint" "src" "test" "dev")}

  outdated-check {:doc "Check outdated Clojure deps versions"
                  :task (clojure "-M:outdated")}

  outdated {:doc "Upgrade outdated Clojure deps versions"
            :task (clojure "-M:outdated --upgrade --force")}

  test {:doc "Run tests"
        :task (clojure "-X:test")}

  frontend-install {:doc "Install frontend deps"
                    :task (shell {:dir "frontend"} "npm" "ci")}

  frontend-dev {:doc "Run frontend dev server with hot reload (also started by (reset) in the REPL)"
                :task (shell {:dir "frontend"} "npm" "run" "dev")}

  frontend-build {:doc "Build frontend into resources/public"
                  :task (shell {:dir "frontend"} "npm" "run" "build")}

  frontend-lint {:doc "Lint and check formatting of frontend code"
                 :task (shell {:dir "frontend"} "npm" "run" "lint")}

  frontend-fmt {:doc "Fix lint issues and formatting of frontend code"
                :task (shell {:dir "frontend"} "npm" "run" "lint:fix")}

  frontend-typecheck {:doc "Typecheck frontend code"
                      :task (shell {:dir "frontend"} "npm" "run" "typecheck")}

  frontend-test {:doc "Run frontend tests"
                 :task (shell {:dir "frontend"} "npm" "run" "test")}

  check-backend {:doc "Run all code checks and tests for backend"
                 :depends [fmt-check lint test]}

  check-frontend {:doc "Run all code checks and tests for frontend"
                  :depends [frontend-lint frontend-typecheck frontend-test]}

  check {:doc "Run all code checks and tests for backend and frontend"
         :depends [check-backend check-frontend]}

  build {:doc "Build application uberjar with the frontend included"
         :depends [frontend-build]
         :task (clojure "-T:build build")}}}
