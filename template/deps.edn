{:deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ; logging
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        ch.qos.logback/logback-classic {:mvn/version "1.6.6"}
        ; system & config
        integrant/integrant {:mvn/version "1.0.1"}
        aero/aero {:mvn/version "1.1.6"}
        metosin/malli {:mvn/version "0.20.3"}
        ; server
        metosin/reitit-ring {:mvn/version "0.11.0"}
        metosin/reitit-middleware {:mvn/version "0.11.0"}
        metosin/reitit-malli {:mvn/version "0.11.0"}
        metosin/reitit-dev {:mvn/version "0.11.0"}
        ring/ring-defaults {:mvn/version "0.7.1"}
        amalloy/ring-gzip-middleware {:mvn/version "0.1.4"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        ; db
        hikari-cp/hikari-cp {:mvn/version "4.1.0"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        com.github.seancorfield/honeysql {:mvn/version "2.8.85"}
        dev.weavejester/ragtime {:mvn/version "0.12.1"}}

 :paths ["src" "resources"]

 :aliases {; SQLite JDBC driver loads a native library
           :dev {:extra-paths ["dev"]
                 :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                 :extra-deps {integrant/repl {:mvn/version "0.5.1"}
                              ring/ring-devel {:mvn/version "1.15.6"}}}

           :test {:extra-paths ["test"]
                  :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                  :extra-deps {eftest/eftest {:mvn/version "0.6.0"}
                               cloverage/cloverage {:mvn/version "1.2.4"}
                               io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                               clj-http/clj-http {:mvn/version "3.13.1"}
                               cheshire/cheshire {:mvn/version "6.2.0"}}
                  :exec-fn cloverage.coverage/run-project
                  :exec-args {:test-ns-path ["test"]
                              :src-ns-path ["src"]
                              :runner :eftest
                              :runner-opts {:multithread? false}}}

           :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
                      :main-opts ["-m" "antq.core" "--no-diff"]}

           :build {:deps {io.github.abogoyavlensky/slim {:mvn/version "0.3.2"}}
                   :ns-default slim.app
                   :exec-args {:main-ns {{ project-name }}.core
                               :src-dirs ["src" "resources"]}}}}
