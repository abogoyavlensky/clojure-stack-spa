{:{{ project-name }}.db/db
 {:jdbc-url #profile {:default "jdbc:sqlite:db/{{ project-name }}.sqlite"
                      ; shared in-memory database: every pooled connection sees the same data
                      :test "jdbc:sqlite:file:testdb?mode=memory&cache=shared"}}

 :{{ project-name }}.server/server
 {:options {:port #profile {:default 8000
                            :prod 80
                            :test #free-port true}
            :session-secret-key #profile {:default "test-secret-key"
                                          :prod #env SESSION_SECRET_KEY}
            :cookie-attrs-secure? #profile {:default false
                                            :prod true}
            ; Origins allowed to call the API cross-origin with credentials.
            ; The app's own frontend is same-origin and needs no entry here.
            :allowed-origins []
            :expose-errors? #profile {:default false
                                      :dev true
                                      :test true}
            :auto-reload? #profile {:default false
                                    :dev true}
            :cache-assets? #profile {:default false
                                     :prod true}}
  :db #ig/ref :{{ project-name }}.db/db}}
